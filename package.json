{
  "name": "eslint-cli-bundle",
  "version": "2.0.0",
  "description": "Bundled version of eslint",
  "author": "silverwind",
  "repository": "silverwind/eslint-cli-bundle",
  "license": "BSD-2-Clause",
  "bin": {
    "eslint": "dist/eslint.js",
    "eslint-cli-bundle": "dist/eslint.js"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "eslint": "10.3.0",
    "eslint-config-silverwind": "133.0.1",
    "jest-extended": "7.0.0",
    "jiti": "2.7.0",
    "patch-package": "8.0.1",
    "tsdown": "0.22.0",
    "tsdown-config-silverwind": "3.0.1",
    "typescript": "6.0.3",
    "typescript-config-silverwind": "18.0.0",
    "updates": "17.16.10",
    "updates-config-silverwind": "4.0.0",
    "versions": "15.0.3"
  }
}
