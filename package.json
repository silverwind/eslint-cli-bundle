{
  "name": "eslint-cli-bundle",
  "version": "3.0.0",
  "description": "Bundled version of eslint",
  "author": "silverwind <me@silverwind.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverwind/eslint-cli-bundle.git"
  },
  "license": "BSD-2-Clause",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "eslint": "dist/eslint.js",
    "eslint-cli-bundle": "dist/eslint.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.7.0",
    "@eslint/core": "1.2.1",
    "@eslint/plugin-kit": "0.7.3",
    "@types/estree": "1.0.10",
    "eslint": "10.14.0",
    "eslint-config-silverwind": "155.2.0",
    "jiti": "2.7.0",
    "tsdown": "0.23.4",
    "tsdown-config-silverwind": "4.2.0",
    "typescript": "7.0.2",
    "typescript-config-silverwind": "21.0.2",
    "updates": "20.0.0",
    "updates-config-silverwind": "4.1.0",
    "versions": "15.5.2"
  }
}
