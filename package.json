{
  "name": "eslint-cli-bundle",
  "version": "2.0.0",
  "description": "Bundled version of eslint",
  "author": "silverwind",
  "repository": "silverwind/eslint-cli-bundle",
  "license": "BSD-2-Clause",
  "bin": {
    "eslint": "dist/eslint.js",
    "eslint-cli-bundle": "dist/eslint.js"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.5.5",
    "@typescript/native-preview": "7.0.0-dev.20260413.1",
    "eslint": "10.2.0",
    "eslint-config-silverwind": "131.0.4",
    "jest-extended": "7.0.0",
    "jiti": "2.6.1",
    "patch-package": "8.0.1",
    "tsdown": "0.21.7",
    "tsdown-config-silverwind": "2.0.5",
    "typescript": "5.9.3",
    "typescript-config-silverwind": "17.0.0",
    "updates": "17.15.2",
    "updates-config-silverwind": "2.1.0",
    "versions": "14.3.1"
  }
}
