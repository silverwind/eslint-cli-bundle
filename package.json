{
  "name": "eslint-cli-bundle",
  "version": "1.0.5",
  "description": "Bundled version of eslint",
  "author": "silverwind",
  "repository": "silverwind/eslint-cli-bundle",
  "license": "BSD-2-Clause",
  "bin": {
    "eslint": "dist/eslint.js",
    "eslint-cli-bundle": "dist/eslint.js"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.5.3",
    "@typescript/native-preview": "7.0.0-dev.20260325.1",
    "eslint": "10.1.0",
    "eslint-config-silverwind": "127.1.4",
    "jiti": "2.6.1",
    "patch-package": "8.0.1",
    "tsdown": "0.21.5",
    "tsdown-config-silverwind": "2.0.3",
    "typescript": "5.9.3",
    "typescript-config-silverwind": "16.1.0",
    "updates": "17.11.6",
    "updates-config-silverwind": "2.0.1",
    "versions": "14.2.5"
  }
}
