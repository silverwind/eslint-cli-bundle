{
  "name": "eslint-cli-bundle",
  "version": "1.0.5",
  "description": "Bundled version of eslint",
  "author": "silverwind",
  "repository": "silverwind/eslint-cli-bundle",
  "license": "BSD-2-Clause",
  "bin": {
    "eslint": "dist/eslint.js",
    "eslint-cli-bundle": "dist/eslint.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260214.1",
    "eslint": "9.39.2",
    "eslint-config-silverwind": "121.0.5",
    "patch-package": "8.0.1",
    "tsdown": "0.20.3",
    "tsdown-config-silverwind": "1.7.5",
    "typescript": "5.9.3",
    "typescript-config-silverwind": "15.0.0",
    "updates": "17.5.2",
    "updates-config-silverwind": "1.0.3",
    "versions": "14.1.2"
  }
}
