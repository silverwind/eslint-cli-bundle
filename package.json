{
  "name": "eslint-cli-bundle",
  "version": "2.0.1",
  "description": "Bundled version of eslint",
  "author": "silverwind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverwind/eslint-cli-bundle.git"
  },
  "license": "BSD-2-Clause",
  "bin": {
    "eslint": "dist/eslint.js",
    "eslint-cli-bundle": "dist/eslint.js"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "10.11.0",
    "eslint-config-silverwind": "151.0.1",
    "jest-extended": "7.0.0",
    "jiti": "2.7.0",
    "patch-package": "8.0.1",
    "tsdown": "0.23.0",
    "tsdown-config-silverwind": "4.1.2",
    "typescript": "6.0.3",
    "typescript-config-silverwind": "21.0.1",
    "updates": "19.0.2",
    "updates-config-silverwind": "4.0.7",
    "versions": "15.5.1"
  }
}
